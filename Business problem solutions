echo '================================================================'
— BUSINESS PROBLEMS (Q1–Q7)'
\echo '================================================================'

\echo ''
\echo '--- Q1. Count Movies vs TV Shows ---'
EXPLAIN ANALYZE
SELECT type, COUNT(*) AS total_count
FROM netflix
GROUP BY type
ORDER BY total_count DESC;

\echo ''
\echo '--- Q2. Most Common Rating per Type ---'
WITH rating_rank AS (
  SELECT type, rating, COUNT(*) AS cnt,
         RANK() OVER (PARTITION BY type ORDER BY COUNT(*) DESC) AS rnk
  FROM netflix
  GROUP BY type, rating
)
SELECT type, rating AS most_common_rating, cnt AS count
FROM rating_rank
WHERE rnk = 1;

\echo ''
\echo '--- Q3. All Movies Released in 2020 ---'
EXPLAIN ANALYZE
SELECT show_id, title, release_year
FROM netflix
WHERE type = 'Movie' AND release_year = 2020
ORDER BY title;

\echo ''
\echo '--- Q4. Top 5 Countries with Most Content ---'
SELECT
  TRIM(UNNEST(STRING_TO_ARRAY(country, ','))) AS country_name,
  COUNT(*) AS content_count
FROM netflix
GROUP BY country_name
ORDER BY content_count DESC
LIMIT 5;

\echo ''
\echo '--- Q5. Longest Movie ---'
SELECT show_id, title, duration,
       CAST(REGEXP_REPLACE(duration, '[^0-9]', '', 'g') AS INT) AS minutes
FROM netflix
WHERE type = 'Movie'
ORDER BY minutes DESC
LIMIT 1;

\echo ''
\echo '--- Q6. Content Added in the Last 5 Years ---'
SELECT show_id, title, type,
       TO_DATE(date_added, 'Month DD, YYYY') AS parsed_date
FROM netflix
WHERE TO_DATE(date_added, 'Month DD, YYYY') >= CURRENT_DATE - INTERVAL '5 years'
ORDER BY parsed_date DESC;

\echo ''
\echo '--- Q7. All Movies/TV Shows by Director Rajiv Chilaka ---'
EXPLAIN ANALYZE
SELECT show_id, type, title, director, release_year
FROM netflix
WHERE director = 'Rajiv Chilaka';


\echo '--- Q8. TV Shows with More Than 5 Seasons ---'
SELECT show_id, title, duration,
       CAST(REGEXP_REPLACE(duration, '[^0-9]', '', 'g') AS INT) AS num_seasons
FROM netflix
WHERE type = 'TV Show'
  AND CAST(REGEXP_REPLACE(duration, '[^0-9]', '', 'g') AS INT) > 5
ORDER BY num_seasons DESC;

\echo ''
\echo '--- Q9. Number of Content Items per Genre ---'
SELECT
  TRIM(genre) AS genre,
  COUNT(*) AS content_count
FROM (
  SELECT UNNEST(STRING_TO_ARRAY(listed_in, ',')) AS genre
  FROM netflix
) sub
GROUP BY genre
ORDER BY content_count DESC;

\echo ''
\echo '--- Q10. Top 5 Years — Avg Content Release in India ---'
SELECT
  release_year,
  COUNT(*) AS yearly_count,
  ROUND(COUNT(*) * 1.0 /
    (SELECT COUNT(DISTINCT release_year) FROM netflix WHERE country ILIKE '%India%'), 2)
    AS avg_content_per_year
FROM netflix
WHERE country ILIKE '%India%'
GROUP BY release_year
ORDER BY yearly_count DESC
LIMIT 5;

\echo ''
\echo '--- Q11. Movies that are Documentaries ---'
SELECT show_id, title, listed_in
FROM netflix
WHERE type = 'Movie'
  AND listed_in ILIKE '%documentary%'
   OR listed_in ILIKE '%Documentary%'
ORDER BY title;

\echo ''
\echo '--- Q12. All Content without a Director ---'
SELECT show_id, type, title
FROM netflix
WHERE director IS NULL OR director = ''
ORDER BY type, title;

\echo ''
\echo '--- Q13. Movies with Salman Khan in Last 10 Years ---'
SELECT show_id, title, release_year, casts
FROM netflix
WHERE type = 'Movie'
  AND casts ILIKE '%Salman Khan%'
  AND release_year >= EXTRACT(YEAR FROM CURRENT_DATE) - 10
ORDER BY release_year DESC;

\echo ''
\echo '--- Q14. Top 10 Actors in Indian Movies (by Appearance Count) ---'
SELECT
  TRIM(actor) AS actor_name,
  COUNT(*) AS movie_appearances
FROM (
  SELECT UNNEST(STRING_TO_ARRAY(casts, ',')) AS actor
  FROM netflix
  WHERE country ILIKE '%India%'
    AND type = 'Movie'
) sub
GROUP BY actor_name
ORDER BY movie_appearances DESC
LIMIT 10;

\echo ''
\echo '--- Q15 (Bonus). Categorize Content: Bad (kill/violence) vs Good ---'
EXPLAIN ANALYZE
SELECT
  category,
  COUNT(*) AS total_content
FROM (
  SELECT
    CASE
      WHEN description ILIKE '%kill%' OR description ILIKE '%violence%'
      THEN 'Bad'
      ELSE 'Good'
    END AS category
  FROM netflix
) classified
GROUP BY category
ORDER BY total_content DESC;

